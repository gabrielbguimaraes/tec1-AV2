generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  DESMEMBRADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  SMARTPHONE
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  DESGASTADO
  ESTADO_RUIM
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  SUCATA_DEFINITIVA
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_FINAL
  BAIXA_DEFINITIVA
}

model Credencial {
  id           String       @id @default(uuid())
  usuario      String       @unique
  hashSenha    String
  salt         String?
  papel        PapelUsuario
  ultimoAcesso DateTime?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
}

model Organizacao {
  id                String    @id @default(uuid())
  razaoSocial       String
  cnpj              String    @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  ativo             Boolean   @default(true)
  versao            Int       @default(1)
  contrato          Contrato?
  lotes             Lote[]
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
}

model Contrato {
  id                  String      @id @default(uuid())
  organizacaoId       String      @unique
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  dataInicio          DateTime
  dataVencimento      DateTime
  valorTotal          Float
  renovacaoAutomatica Boolean     @default(false)
  versao              Int         @default(1)
  criadoEm            DateTime    @default(now())
  atualizadoEm        DateTime    @updatedAt
}

model Lote {
  id                  String          @id @default(uuid())
  numeroLote          String          @unique
  organizacaoId       String
  organizacao         Organizacao     @relation(fields: [organizacaoId], references: [id])
  dataEntrada         DateTime
  transportadora      String
  statusProcessamento StatusLote      @default(RECEBIDO)
  observacoes         String?
  versao              Int             @default(1)
  equipamentos        Equipamento[]
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
}

model Equipamento {
  id                  String             @id @default(uuid())
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  pesoKg              Float
  estadoFisico        EstadoFisico
  precificacaoEstimada Float
  status              StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  loteId              String
  lote                Lote               @relation(fields: [loteId], references: [id], onDelete: Cascade)
  versao              Int                @default(1)
  movimentacoes       Movimentacao[]
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt
}

model Movimentacao {
  id            String      @id @default(uuid())
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacoes   String?
}

model JournalTransacao {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  operacao    String
  entidade    String
  dadosAntes  Json?
  dadosDepois Json?
  operador    String
  ipOrigem    String?
  sucesso     Boolean  @default(true)
}
