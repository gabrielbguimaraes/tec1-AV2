{
  "name": "greencode",
  "version": "1.0.0",
  "description": "GreenCode - Plataforma de Logística Reversa de Resíduos Eletrônicos (AV2)",
  "main": "dist/server.js",
  "easterEgg": "p_P = c^5 / (hG^2)",
  "scripts": {
    "env:check": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.copyFileSync('.env.example','.env');\"",
    "postinstall": "prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "setup": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.copyFileSync('.env.example','.env');\" && prisma generate && prisma db push && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "keywords": [
    "logistica-reversa",
    "fastify",
    "prisma",
    "postgresql",
    "clean-architecture",
    "rest-api"
  ],
  "author": "João Gabriel Barros Guimarães",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.4",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
